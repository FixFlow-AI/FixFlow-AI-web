 # Corsair's @corsair-dev/* plugins declare a peer dependency on zod@^4, but this
# app is built on zod@^3 (all backend validation schemas use the v3 API).
# legacy-peer-deps lets npm install proceed with the app's zod@3 instead of
# failing on ERESOLVE. Applies to local + Render installs (Render runs
# `npm install` from this directory).
legacy-peer-deps=true

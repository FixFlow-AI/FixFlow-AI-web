# Copy this file to `.env` and fill in the values.

# ──────────────────────────────────────────────────────────────────────────
# AI features — now served by the Python AI service (see ai-service/)
# The Gemini API key lives in ai-service/.env, NOT here.
# ──────────────────────────────────────────────────────────────────────────

# Base URL of the Python AI service. Required for AI features (brief parsing,
# confidence grid, interview generation, contract extensions).
AI_SERVICE_URL=http://localhost:8000

# Optional shared secret. If set, it is sent to the AI service as the
# `x-ai-service-token` header and must match AI_SERVICE_TOKEN in ai-service/.env.
AI_SERVICE_TOKEN=

# Optional: port the API server listens on. Defaults to 4000.
PORT=4000

# ──────────────────────────────────────────────────────────────────────────
# AI-006 Matching — freelancer data source (no data is hardcoded in the engine)
# ──────────────────────────────────────────────────────────────────────────

# Where freelancer profiles come from: "seed" (local JSON file) or "http" (your API).
FREELANCER_PROVIDER=seed

# Required only when FREELANCER_PROVIDER=http. Should return either a JSON array
# of profiles or an object shaped like { "freelancers": [...] }.
FREELANCER_API_URL=

# Optional: override the seed file path (defaults to ./data/freelancers.seed.json).
FREELANCER_SEED_FILE=

# Optional: override matching weights (must be >= 0; they are applied as-is).
# Defaults: skill .25, github .20, domain .15, budget .15, reputation .10, availability .10, sbt .05
MATCH_W_SKILL=
MATCH_W_GITHUB=
MATCH_W_DOMAIN=
MATCH_W_BUDGET=
MATCH_W_REPUTATION=
MATCH_W_AVAILABILITY=
MATCH_W_SBT=

# Optional: extend skill synonym normalization, e.g. {"gcp":"google cloud","pg":"postgresql"}
MATCH_SKILL_SYNONYMS=

# ──────────────────────────────────────────────────────────────────────────
# Database (placeholder for future Prisma/Postgres integration)
# When you wire a DB, implement a database-backed FreelancerRepository and an
# escrow repository, then read this connection string here.
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=

# ──────────────────────────────────────────────────────────────────────────
# Authentication — JWT sessions + Google OAuth (Sign in with Google)
# ──────────────────────────────────────────────────────────────────────────

# REQUIRED: random 32+ byte string used to sign access JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional token TTLs. Format: "<number><s|m|h|d>". Defaults: 30m access, 7d refresh.
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# Optional JWT issuer/audience labels (claims). Match these on the client if you
# validate JWTs there. Defaults: fixflowai / fixflowai-clients.
JWT_ISSUER=fixflowai
JWT_AUDIENCE=fixflowai-clients

# REQUIRED for Google sign-in: OAuth 2.0 Client ID (Web application).
# Create at https://console.cloud.google.com/apis/credentials and add your frontend
# origin (e.g. http://localhost:5173) as an authorized JavaScript origin.
GOOGLE_OAUTH_CLIENT_ID=
# Optional: comma-separated extra audiences if you have iOS/Android client IDs.
GOOGLE_OAUTH_ALLOWED_AUDIENCES=

# ──────────────────────────────────────────────────────────────────────────
# GitHub OAuth — REQUIRED for freelancer sign-in (freelancers log in only via
# GitHub so we can analyze their repositories). Create an OAuth App at
# https://github.com/settings/developers
# ──────────────────────────────────────────────────────────────────────────
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must match the redirect_uri the frontend sends (e.g. http://localhost:5173/).
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/

# Freelancer deep-scan tuning (roles/01, AIA-03) — used once the scan is wired.
GITHUB_SCAN_CONCURRENCY=6
SCAN_TOP_N_REPOS=50
PROFILE_CONFIDENCE_THRESHOLD=75

# ──────────────────────────────────────────────────────────────────────────
# User store — same swappable pattern as the freelancer repository
# ──────────────────────────────────────────────────────────────────────────
USER_PROVIDER=seed
USER_SEED_FILE=
USER_API_URL=

# ──────────────────────────────────────────────────────────────────────────
# AWS / DynamoDB (used once you implement the DynamoDB-backed repositories)
# Provision tables first: see infra/dynamodb/ (create-tables.ps1 / .sh)
# ──────────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
DDB_TABLE_PREFIX=fixflow

# Optional: target DynamoDB Local instead of real AWS (docker run amazon/dynamodb-local)
# DDB_ENDPOINT=http://localhost:8000

# S3 bucket for file uploads (briefs, deliverables, evidence). Created in ap-south-1.
S3_UPLOAD_BUCKET=fixflowai-uploads-019711413699
# Presigned-URL expiry in seconds (default 900 = 15 min) when you wire uploads.
S3_PRESIGN_EXPIRY=900

# Credentials: prefer `aws configure` / IAM role / SSO over putting keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Payments & Escrow (Razorpay)
# ──────────────────────────────────────────────────────────────────────────
# Razorpay Key ID and Secret (for test mode e.g., rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook Secret generated when setting up your Razorpay webhook endpoint
RAZORPAY_WEBHOOK_SECRET=

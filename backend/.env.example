# Copy this file to `.env` and fill in the values.

# Google Gemini API key. Required for AI features (brief parsing, confidence grid,
# interview generation, contract extensions). Deterministic calculators work without it.
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to Gemini 3.5 Flash.
GEMINI_MODEL=Gemini 3.5 Flash

# Optional: port the API server listens on. Defaults to 4000.
PORT=4000

# ──────────────────────────────────────────────────────────────────────────
# AI-006 Matching — freelancer data source (no data is hardcoded in the engine)
# ──────────────────────────────────────────────────────────────────────────

# Where freelancer profiles come from: "seed" (local JSON file) or "http" (your API).
FREELANCER_PROVIDER=seed

# Required only when FREELANCER_PROVIDER=http. Should return either a JSON array
# of profiles or an object shaped like { "freelancers": [...] }.
FREELANCER_API_URL=

# Optional: override the seed file path (defaults to ./data/freelancers.seed.json).
FREELANCER_SEED_FILE=

# Optional: override matching weights (must be >= 0; they are applied as-is).
# Defaults: skill .25, github .20, domain .15, budget .15, reputation .10, availability .10, sbt .05
MATCH_W_SKILL=
MATCH_W_GITHUB=
MATCH_W_DOMAIN=
MATCH_W_BUDGET=
MATCH_W_REPUTATION=
MATCH_W_AVAILABILITY=
MATCH_W_SBT=

# Optional: extend skill synonym normalization, e.g. {"gcp":"google cloud","pg":"postgresql"}
MATCH_SKILL_SYNONYMS=

# ──────────────────────────────────────────────────────────────────────────
# Database (placeholder for future Prisma/Postgres integration)
# When you wire a DB, implement a database-backed FreelancerRepository and an
# escrow repository, then read this connection string here.
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL=

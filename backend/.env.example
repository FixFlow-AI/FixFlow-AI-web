# Copy this file to `.env` and fill in the values.

# Google Gemini API key. Required for AI features (brief parsing, confidence grid,
# interview generation, contract extensions). Deterministic calculators work without it.
GEMINI_API_KEY=

# Optional: override the Gemini model. Defaults to Gemini 3.5 Flash.
GEMINI_MODEL=Gemini 3.5 Flash

# Optional: port the API server listens on. Defaults to 4000.
PORT=4000

# Server
PORT=5000
NODE_ENV=development

# Frontend
FRONTEND_URL=http://localhost:3001
FRONTEND_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173

# Auth (JWT)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_OAUTH_SCOPE=openid email profile

# SMTP (OTP + lifecycle email delivery)
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM="FixFlowAI <no-reply@example.com>"
EMAIL_FROM_ADDRESS=hello@fixflowai.com
EMAIL_FROM_NAME=FixFlowAI
ADMIN_ALERT_EMAIL=alerts@example.com

# Stripe (billing, optional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_FREE_PRICE_ID=your_stripe_free_price_id_here
STRIPE_PRO_PRICE_ID=your_stripe_pro_price_id_here
STRIPE_AGENCY_PRICE_ID=your_stripe_agency_price_id_here
STRIPE_SOLO_PRICE_ID=your_stripe_solo_price_id_here

# LLM providers
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite-preview
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_STRUCTURED_MODEL=gemini-3.1-flash-lite-preview
GEMINI_STRUCTURED_FALLBACKS=gemini-2.5-flash-lite,gemini-3-flash-preview,gemini-2.5-flash
GEMINI_MODEL_RPM_OVERRIDES=
GEMINI_MAX_QUEUE_WAIT_MS=20000
GEMINI_KEY_GUARD_MS=900000
LLM_PROVIDER_ORDER=gemini,openrouter,xai,ollama

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MODEL_FALLBACKS=
OPENROUTER_SITE_URL=http://localhost:3001
OPENROUTER_APP_NAME=FixFlowAI

XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.20-reasoning
XAI_MODEL_FALLBACKS=

OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_MODEL_FALLBACKS=

# Opportunity discovery providers (Freelancer OS)
OPPORTUNITY_SEARCH_PROVIDER_ORDER=apify,tavily,brave,serpapi
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_UPWORK_ACTOR_ID=your_apify_upwork_actor_id_here
APIFY_FIVERR_ACTOR_ID=your_apify_fiverr_actor_id_here
APIFY_FREELANCER_ACTOR_ID=your_apify_freelancer_actor_id_here
OPPORTUNITY_DISCOVERY_DEMO_FALLBACK=true
ALLOW_DEMO_SEED=false
BID_MATCH_THRESHOLD=70

# AWS / DynamoDB / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=
DYNAMODB_TABLE_PREFIX=fixflowai
DYNAMODB_ENDPOINT=
S3_BUCKET=your_s3_bucket_name_here

# Slack integration
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback
SLACK_SCOPES=incoming-webhook
INTEGRATION_SECRET=your_integration_secret_here

# Runtime controls
STREAM_TIMEOUT_MS=120000
PUPPETEER_EXECUTABLE_PATH=
USE_FAKE_LLM=false

# Rate-limit monitoring
RATE_LIMIT_MONITOR_ENABLED=true
RATE_LIMIT_NEAR_THRESHOLD=0.85
RATE_LIMIT_ALERT_COOLDOWN_SEC=600
RATE_LIMIT_RESTORE_COOLDOWN_SEC=60
RATE_LIMIT_RETRY_MAX_ATTEMPTS=5
RATE_LIMIT_RETRY_BASE_DELAY_MS=1500

# Waitlist table: resolved as DYNAMODB_TABLE_PREFIX + "waitlist" → fixflowai_waitlist
# Create it with: aws dynamodb create-table --table-name fixflowai_waitlist --attribute-definitions AttributeName=_id,AttributeType=S --key-schema AttributeName=_id,KeyType=HASH --billing-mode PAY_PER_REQUEST --region us-east-1

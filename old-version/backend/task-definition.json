{
  "family": "fixflowai-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "1024",
  "taskRoleArn": "arn:aws:iam::034476915822:role/proplytics-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::034476915822:role/proplytics-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "fixflowai-backend",
      "image": "034476915822.dkr.ecr.us-east-1.amazonaws.com/fixflowai-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/JWT_SECRET"
        },
        {
          "name": "JWT_REFRESH_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/JWT_REFRESH_SECRET"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/GEMINI_API_KEY"
        },
        {
          "name": "FRONTEND_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/FRONTEND_URL"
        },
        {
          "name": "FRONTEND_ALLOWED_ORIGINS",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/FRONTEND_ALLOWED_ORIGINS"
        },
        {
          "name": "GITHUB_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/GITHUB_CLIENT_ID"
        },
        {
          "name": "GITHUB_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/GITHUB_CLIENT_SECRET"
        },
        {
          "name": "GITHUB_CALLBACK_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/GITHUB_CALLBACK_URL"
        },
        {
          "name": "GITHUB_OAUTH_SCOPE",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/GITHUB_OAUTH_SCOPE"
        },
        {
          "name": "SMTP_HOST",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_HOST"
        },
        {
          "name": "SMTP_PORT",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_PORT"
        },
        {
          "name": "SMTP_SECURE",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_SECURE"
        },
        {
          "name": "SMTP_USER",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_USER"
        },
        {
          "name": "SMTP_PASS",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_PASS"
        },
        {
          "name": "SMTP_FROM",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/SMTP_FROM"
        },
        {
          "name": "INTEGRATION_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:034476915822:parameter/proplytics/dev/INTEGRATION_SECRET"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "S3_BUCKET",
          "value": "fixflowai-assets-dev"
        },
        {
          "name": "DYNAMODB_TABLE_PREFIX",
          "value": "fixflowai"
        },
        {
          "name": "REQUEST_BODY_LIMIT",
          "value": "1mb"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fixflowai-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://localhost:5000/api/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}

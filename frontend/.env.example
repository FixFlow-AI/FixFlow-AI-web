# Frontend environment (Vite). Variables must be prefixed with VITE_.
# Copy to `.env` and fill in.

# Google OAuth Web Client ID — must match GOOGLE_OAUTH_CLIENT_ID on the backend
# and have your dev origin (http://localhost:5173) as an authorized JS origin.
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth Client ID (public) — freelancers sign in with GitHub.
# Create an OAuth App at https://github.com/settings/developers with the
# Authorization callback URL set to your app origin (e.g. http://localhost:5173/).
VITE_GITHUB_CLIENT_ID=
# Optional: override the OAuth redirect URI (defaults to window.location.origin + "/").
VITE_GITHUB_REDIRECT_URI=

# Optional: point at a deployed backend. Empty = use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Razorpay Key ID for client checkout initialization (for test mode, e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=

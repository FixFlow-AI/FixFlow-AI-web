# Frontend environment (Vite). Variables must be prefixed with VITE_.
# Copy to `.env` and fill in.

# Google OAuth Web Client ID — must match GOOGLE_OAUTH_CLIENT_ID on the backend
# and have your dev origin (http://localhost:5173) as an authorized JS origin.
VITE_GOOGLE_CLIENT_ID=

# Optional: point at a deployed backend. Empty = use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Razorpay Key ID for client checkout initialization (for test mode, e.g. rzp_test_...)
VITE_RAZORPAY_KEY_ID=

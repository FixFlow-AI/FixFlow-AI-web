# Copy this file to `.env` and fill in the values.

# Google Gemini API key. REQUIRED for all AI features.
GEMINI_API_KEY=

# Gemini model id. Use a real model (e.g. gemini-2.5-flash or gemini-2.5-pro).
GEMINI_MODEL=gemini-2.5-flash

# Port the FastAPI service listens on. Defaults to 8000.
PORT=8000

# Confidence Grid tuning (AI-002).
CONFIDENCE_THRESHOLD=75
MAX_CORRECTION_CYCLES=1

# Optional shared secret. If set, the TS backend must send it as
# `x-ai-service-token`. Leave blank to disable the check (dev only).
AI_SERVICE_TOKEN=

# ── GitHub onboarding scan (roles/01) ──────────────────────────────────────
# Optional server-side GitHub token used as a FALLBACK when a scan request
# doesn't carry the freelancer's OAuth access token. GraphQL requires *some*
# token. Create a fine-grained PAT (read-only, public repos) at
# https://github.com/settings/tokens . Leave blank to require the user token.
GITHUB_TOKEN=

# Deterministic fan-out concurrency over repos (default 6).
GITHUB_SCAN_CONCURRENCY=6
# Cap deep analysis to the top-N repos by recency + stars + ownership (default 50).
SCAN_TOP_N_REPOS=50
# Profile confidence "match-ready" threshold (default 75).
PROFILE_CONFIDENCE_THRESHOLD=75
